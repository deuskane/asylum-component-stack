CAPI=2:

#-----------------------------------------------------------------------------
# Title      : Stack Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : stack.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2025-09-06  1.0.1    mrosiere Update deps
# 2026-10-05  1.0.2    mrosiere UVVM testbench, OVERWRITE parameter type int,
#                               add sim_overwrite target
#-----------------------------------------------------------------------------

name : asylum:component:stack:1.0.2
description : Stack

filesets:

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files        :
      - hdl/stack_pkg.vhd
      - hdl/stack.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:component:ram:1.0.0"
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/tb_stack.vhd
    file_type : vhdlSource-2008
    depend    :
      - bitvis:verification:uvvm

  #---------------------------------------
  # Lint Files (post_run hook of lint_ghdl_synth)
  #---------------------------------------
  files_lint:
    files:
      - syn/ghdl/ghdl_synth.sh : {file_type : user, copyto : ghdl_synth.sh}

targets:

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : stack
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl :
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of stack)
    toplevel        : asylum.stack
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : lint_ghdl, then ghdl --synth -Wall of stack
  # for each configuration of syn/ghdl/ghdl_synth.sh (post_run hook)
  #---------------------------------------
  lint_ghdl_synth :
    << : *default
    description     : Synthesis check, ghdl --synth -Wall of stack (4 configurations)
    toplevel        : asylum.stack
    filesets_append : [files_lint]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]
    hooks :
      post_run : [ghdl_synth]

  sim_basic:
    << : *default
    description     : Simulation of all cases (OVERWRITE = 0)
    filesets_append :
      - files_sim
    toplevel        : tb_stack
    parameters      :
      - WIDTH=8
      - DEPTH=8
      - OVERWRITE=0
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  sim_overwrite:
    << : *default
    description     : Simulation of all cases (OVERWRITE = 1)
    filesets_append :
      - files_sim
    toplevel        : tb_stack
    parameters      :
      - WIDTH=16
      - DEPTH=4
      - OVERWRITE=1
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

scripts:

  #---------------------------------------
  # Hook of lint_ghdl_synth (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

parameters :

  WIDTH :
    description : Word width
    datatype    : int
    default     : 8
    paramtype   : generic

  DEPTH :
    description : Number of words
    datatype    : int
    default     : 8
    paramtype   : generic

  OVERWRITE :
    description : Allow the write if the stack is full (0 = no, /= 0 = yes)
    datatype    : int
    default     : 0
    paramtype   : generic
